# 이 파일을 .env.local 로 복사한 뒤 키를 채워 넣으세요.

# Google AI Studio(https://aistudio.google.com/apikey)에서 무료로 발급
# 무료 티어는 요청/응답 데이터가 Google 제품 개선에 쓰일 수 있어요. (유료 결제로 전환하면 안 쓰임)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키
# REST API 키: 서버에서 장소 검색용 (브라우저에 노출되지 않음)
KAKAO_REST_KEY=
# JavaScript 키: 브라우저에서 지도 표시용 (NEXT_PUBLIC_ 이 붙어야 브라우저에서 읽힘)
NEXT_PUBLIC_KAKAO_JS_KEY=
